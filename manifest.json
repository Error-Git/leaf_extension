{
    "manifest_version": 3,
    "name": "Generating Leaves",
    "version": "1.0.0",
    "description": "Weewoowaa",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}